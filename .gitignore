# --- Builds / outputs ---
dist/
build/
out/
.tmp/
tmp/
*.tsbuildinfo
.next/
.nuxt/
.turbo/
.vercel/
.netlify/
.output/
.svelte-kit/

# NestJS / compiled
apps/api/dist/
**/dist/

# --- Env & secrets (keep .env.example tracked) ---
.env
.env.*
!.env.example
!.env*.example
*.pem
*.p12
*.key
credentials.json
service-account*.json
secrets/
.secrets/

# --- Logs ---
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# --- Test / coverage ---
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
