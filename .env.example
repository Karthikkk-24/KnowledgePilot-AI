# --- App ---
APP_NODE_ENV=development
APP_PORT=3001
APP_WEB_ORIGIN=http://localhost:3000

# --- Web (Next.js public) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Database (Postgres + pgvector) ---
# Host port 5433 maps to container 5432 (see docker-compose.yml)
DB_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/knowledgepilot?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Local blob storage (Phase 1) ---
STORAGE_LOCAL_PATH=./uploads
UPLOAD_MAX_BYTES=20971520

# --- Auth (Phase 4) ---
AUTH_SECRET=
AUTH_PROVIDER=

# --- LLM (Phase 1+) ---
# Leave empty to use mock LLM (offline E2E). Set key to use OpenAI-compatible API.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER=openai|mock  (optional override)

# --- Embeddings (Phase 1+) ---
# Leave empty to use mock embeddings when no LLM key either.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
EMBEDDING_BASE_URL=
# EMBEDDING_PROVIDER=openai|mock  (optional override)

# --- Reranker (Phase 2+) ---
# Leave empty to use mock term-overlap reranker when FF_RERANKING=true.
RERANK_API_KEY=
RERANK_MODEL=rerank-english-v3.0
RERANK_BASE_URL=https://api.cohere.com/v1
# RERANK_PROVIDER=http|mock  (optional override)

# --- Object storage (Phase 4) ---
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- RAG defaults (Phase 1+) ---
RAG_DEFAULT_TOP_K=8
RAG_DEFAULT_CHUNK_SIZE=800
RAG_DEFAULT_CHUNK_OVERLAP=120
RAG_ABSTENTION_THRESHOLD=0.15
# Default chat strategy when FF_HYBRID_SEARCH=true
RAG_RETRIEVAL_STRATEGY=hybrid

# --- Feature flags ---
FF_HYBRID_SEARCH=true
FF_RERANKING=false
FF_QUERY_REWRITE=false
FF_PARENT_CHILD=false
FF_EXPERIMENT_LAB=false
FF_MULTI_QUERY=false

