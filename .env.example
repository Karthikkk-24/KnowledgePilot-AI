# --- App ---
APP_NODE_ENV=development
APP_PORT=3001
APP_WEB_ORIGIN=http://localhost:3000

# --- Web (Next.js public) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Database (Postgres + pgvector) ---
DB_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledgepilot?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Auth (Phase 4) ---
AUTH_SECRET=
AUTH_PROVIDER=

# --- LLM (Phase 1+) ---
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# --- Embeddings (Phase 1+) ---
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMS=

# --- Reranker (Phase 2+) ---
RERANK_API_KEY=
RERANK_MODEL=

# --- Object storage (Phase 4; local disk only for early local/dev) ---
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- RAG defaults (Phase 1+) ---
RAG_DEFAULT_TOP_K=8
RAG_DEFAULT_CHUNK_SIZE=800
RAG_DEFAULT_CHUNK_OVERLAP=120
RAG_ABSTENTION_THRESHOLD=0.25

# --- Feature flags ---
FF_HYBRID_SEARCH=false
FF_RERANKING=false
FF_QUERY_REWRITE=false
FF_PARENT_CHILD=false
FF_EXPERIMENT_LAB=false
FF_MULTI_QUERY=false
