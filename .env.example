# --- App ---
APP_NODE_ENV=development
APP_PORT=3001
APP_WEB_ORIGIN=http://localhost:3000

# --- Web (Next.js public) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
# stub (local default) | clerk
NEXT_PUBLIC_AUTH_PROVIDER=stub

# --- Database (Postgres + pgvector) ---
# Host port 5433 maps to container 5432 (see docker-compose.yml)
DB_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/knowledgepilot?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Local blob storage ---
STORAGE_LOCAL_PATH=./uploads
UPLOAD_MAX_BYTES=20971520

# --- Auth (Phase 4) ---
# stub for local demos; clerk for real auth (required in production)
AUTH_PROVIDER=stub
AUTH_SECRET=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- LLM (Phase 1+) ---
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER=openai|mock

# --- Embeddings ---
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
EMBEDDING_BASE_URL=
# EMBEDDING_PROVIDER=openai|mock

# --- Reranker ---
RERANK_API_KEY=
RERANK_MODEL=rerank-english-v3.0
RERANK_BASE_URL=https://api.cohere.com/v1

# --- Object storage (S3-compatible; leave empty to use local disk) ---
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# --- Rate limits / jobs ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
RATE_LIMIT_UPLOAD_LIMIT=20
RATE_LIMIT_CHAT_LIMIT=60
INGESTION_MAX_ATTEMPTS=5
INGESTION_BACKOFF_MS=2000
INGESTION_CONCURRENCY=2
EVAL_CONCURRENCY=1

# --- RAG defaults ---
RAG_DEFAULT_TOP_K=8
RAG_DEFAULT_CHUNK_SIZE=800
RAG_DEFAULT_CHUNK_OVERLAP=120
RAG_ABSTENTION_THRESHOLD=0.15
RAG_RETRIEVAL_STRATEGY=hybrid

# --- Feature flags ---
FF_HYBRID_SEARCH=true
FF_RERANKING=false
FF_QUERY_REWRITE=false
FF_PARENT_CHILD=false
# Unset or true enables lab outside production; false disables even in development
FF_EXPERIMENT_LAB=true
FF_MULTI_QUERY=false
# Agentic RAG (Phase 6) — default off; enable for tool-calling chat/eval
FF_AGENTIC_RAG=false
AGENT_MAX_STEPS=5
AGENT_TIMEOUT_MS=30000
