generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DB_DATABASE_URL")
  extensions = [vector]
}

enum DocumentStatus {
  pending
  queued
  processing
  ready
  failed

  @@map("document_status")
}

enum IngestionJobState {
  queued
  processing
  extracting
  chunking
  embedding
  indexing
  ready
  failed

  @@map("ingestion_job_state")
}

enum MessageRole {
  user
  assistant
  system

  @@map("message_role")
}

enum EvalRunState {
  queued
  running
  completed
  failed
  cancelled

  @@map("eval_run_state")
}

enum MembershipRole {
  owner
  admin
  member
  viewer

  @@map("membership_role")
}

model Tenant {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  documents      Document[]
  conversations  Conversation[]
  ingestionJobs  IngestionJob[]
  benchmarkSets  BenchmarkSet[]
  evalRuns       EvalRun[]
  memberships    Membership[]

  @@map("tenants")
}

model User {
  id          String    @id @default(cuid())
  clerkUserId String?   @unique @map("clerk_user_id")
  email       String?
  name        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  memberships Membership[]

  @@index([email])
  @@map("users")
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  userId    String         @map("user_id")
  role      MembershipRole @default(member)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
  @@map("memberships")
}

model Document {
  id               String         @id @default(cuid())
  tenantId         String         @map("tenant_id")
  title            String
  originalFilename String         @map("original_filename")
  mimeType         String         @map("mime_type")
  storageKey       String         @map("storage_key")
  byteSize         Int            @map("byte_size")
  contentHash      String         @map("content_hash")
  status           DocumentStatus @default(pending)
  pageCount        Int?           @map("page_count")
  chunkingStrategy String         @default("structure_aware") @map("chunking_strategy")
  embeddingModel   String?        @map("embedding_model")
  errorMessage     String?        @map("error_message")
  metadata         Json           @default("{}")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  chunks        Chunk[]
  ingestionJobs IngestionJob[]

  @@unique([tenantId, contentHash])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("documents")
}

model Chunk {
  id           String                       @id @default(cuid())
  tenantId     String                       @map("tenant_id")
  documentId   String                       @map("document_id")
  parentChunkId String?                     @map("parent_chunk_id")
  content      String
  tokenCount   Int                          @map("token_count")
  headingPath  String?                      @map("heading_path")
  pageStart    Int?                         @map("page_start")
  pageEnd      Int?                         @map("page_end")
  charStart    Int                          @map("char_start")
  charEnd      Int                          @map("char_end")
  ordinal      Int
  embedding    Unsupported("vector(1536)")?
  searchVector Unsupported("tsvector")?     @map("search_vector")
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime                     @updatedAt @map("updated_at")

  document  Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent    Chunk?     @relation("ChunkHierarchy", fields: [parentChunkId], references: [id], onDelete: SetNull)
  children  Chunk[]    @relation("ChunkHierarchy")
  citations Citation[]

  @@index([tenantId, documentId])
  @@index([documentId, ordinal])
  @@map("chunks")
}

model IngestionJob {
  id         String            @id @default(cuid())
  tenantId   String            @map("tenant_id")
  documentId String            @map("document_id")
  bullJobId  String?           @map("bull_job_id")
  state      IngestionJobState @default(queued)
  attempt    Int               @default(0)
  progress   Int               @default(0)
  lastError  String?           @map("last_error")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  finishedAt DateTime?         @map("finished_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, state])
  @@index([documentId])
  @@map("ingestion_jobs")
}

model Conversation {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  title     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  messages Message[]

  @@index([tenantId, createdAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  tenantId       String      @map("tenant_id")
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String
  abstained      Boolean     @default(false)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  citations    Citation[]

  @@index([tenantId, conversationId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Citation {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  messageId  String   @map("message_id")
  chunkId    String   @map("chunk_id")
  documentId String   @map("document_id")
  quote      String
  page       Int?
  createdAt  DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunk   Chunk   @relation(fields: [chunkId], references: [id], onDelete: Restrict)

  @@index([messageId])
  @@index([tenantId, chunkId])
  @@map("citations")
}

model BenchmarkSet {
  id          String   @id
  tenantId    String   @map("tenant_id")
  name        String
  version     String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items    BenchmarkItem[]
  evalRuns EvalRun[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("benchmark_sets")
}

model BenchmarkItem {
  id                  String   @id @default(cuid())
  benchmarkSetId      String   @map("benchmark_set_id")
  externalId          String   @map("external_id")
  question            String
  expectedAnswer      String?  @map("expected_answer")
  relevantChunkIds    String[] @default([]) @map("relevant_chunk_ids")
  relevantDocumentIds String[] @default([]) @map("relevant_document_ids")
  relevantPassages    Json     @default("[]") @map("relevant_passages")
  tags                String[] @default([])
  difficulty          String?
  ordinal             Int      @default(0)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  benchmarkSet BenchmarkSet     @relation(fields: [benchmarkSetId], references: [id], onDelete: Cascade)
  results      EvalItemResult[]

  @@unique([benchmarkSetId, externalId])
  @@index([benchmarkSetId, ordinal])
  @@map("benchmark_items")
}

model EvalRun {
  id               String       @id @default(cuid())
  tenantId         String       @map("tenant_id")
  benchmarkSetId   String       @map("benchmark_set_id")
  state            EvalRunState @default(queued)
  label            String?
  configSnapshot   Json         @map("config_snapshot")
  progress         Int          @default(0)
  itemCount        Int          @default(0) @map("item_count")
  completedCount   Int          @default(0) @map("completed_count")
  metricsSummary   Json?        @map("metrics_summary")
  latencyMsTotal   Int?         @map("latency_ms_total")
  estimatedCostUsd Float?       @map("estimated_cost_usd")
  errorMessage     String?      @map("error_message")
  bullJobId        String?      @map("bull_job_id")
  startedAt        DateTime?    @map("started_at")
  finishedAt       DateTime?    @map("finished_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  benchmarkSet BenchmarkSet     @relation(fields: [benchmarkSetId], references: [id], onDelete: Restrict)
  itemResults  EvalItemResult[]

  @@index([tenantId, createdAt])
  @@index([benchmarkSetId, createdAt])
  @@index([tenantId, state])
  @@map("eval_runs")
}

model EvalItemResult {
  id                String   @id @default(cuid())
  evalRunId         String   @map("eval_run_id")
  benchmarkItemId   String   @map("benchmark_item_id")
  question          String
  expectedAnswer    String?  @map("expected_answer")
  retrievedChunkIds String[] @default([]) @map("retrieved_chunk_ids")
  citedChunkIds     String[] @default([]) @map("cited_chunk_ids")
  answerText        String?  @map("answer_text")
  abstained         Boolean  @default(false)
  metrics           Json     @default("{}")
  latencyMs         Json     @default("{}") @map("latency_ms")
  errorMessage      String?  @map("error_message")
  createdAt         DateTime @default(now()) @map("created_at")

  evalRun       EvalRun       @relation(fields: [evalRunId], references: [id], onDelete: Cascade)
  benchmarkItem BenchmarkItem @relation(fields: [benchmarkItemId], references: [id], onDelete: Restrict)

  @@unique([evalRunId, benchmarkItemId])
  @@index([evalRunId])
  @@map("eval_item_results")
}
