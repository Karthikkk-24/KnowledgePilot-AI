{
  "name": "@knowledgepilot/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "clean": "rm -rf dist .turbo",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0"
  },
  "devDependencies": {
    "@knowledgepilot/eslint-config": "workspace:*",
    "@knowledgepilot/typescript-config": "workspace:*",
    "@knowledgepilot/vitest-config": "workspace:*",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "prisma": "^6.9.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
